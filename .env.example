# Copy to .env for local development. Never commit real keys.

# Gemini API key (https://aistudio.google.com/apikey). Without it the app still works
# and shows a curated summary instead of the Gemini coach.
GEMINI_API_KEY=

# Google Maps Platform key restricted to the Air Quality API. Without it the app uses
# Open-Meteo (CAMS) data instead.
GOOGLE_AIR_QUALITY_API_KEY=

# Optional: primary model and comma-separated fallbacks tried in order.
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# Optional: port for the local server (Cloud Run sets this itself).
PORT=8788
